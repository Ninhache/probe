{
  "name": "@ninhache/probe",
  "version": "0.1.0",
  "description": "Health checks for your local dev services, from the CLI or a generated Makefile",
  "license": "MIT",
  "author": "Ninhache",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ninhache/probe.git"
  },
  "type": "module",
  "bin": {
    "probe": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "citty": "^0.2.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^20.19.43",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
